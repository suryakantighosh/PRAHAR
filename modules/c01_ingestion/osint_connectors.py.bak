async def fetch_newsapi(query: str, session: aiohttp.ClientSession) -> dict:
    """NewsAPI.org free tier — 100 req/day."""
    # AFTER — use the module-level constant
    api_key = NEWSAPI_KEY
    if not api_key:
        # Fallback: use RSS feeds
        return await fetch_news_rss(query, session)
    params = {"q": query, "sortBy": "relevancy", "pageSize": 10,
              "language": "en", "apiKey": api_key}
    data = await _get(session, "https://newsapi.org/v2/everything", params=params, label="NewsAPI")
    if data and data.get("articles"):
        arts = data["articles"]
        logger.info(f"[NewsAPI] {len(arts)} articles for: {query}")
        return {
            "source": "newsapi", "query": query,
            "articles": [{"title": a.get("title"), "source": a.get("source", {}).get("name"),
                           "url": a.get("url"), "published": a.get("publishedAt"),
                           "description": a.get("description")} for a in arts],
        }
    return {}


async def fetch_news_rss(query: str, session: aiohttp.ClientSession) -> dict:
    """Google News RSS (no API key needed)."""
    try:
        url = f"https://news.google.com/rss/search?q={query.replace(' ', '+')}&hl=en"
        async with session.get(url, headers=HEADERS_BROWSER, timeout=TIMEOUT) as r:
            if r.status == 200:
                text = await r.text()
                # Parse titles from RSS
                import re
                # AFTER
                titles = re.findall(r'<title>(.*?)</title>', text)
                links  = re.findall(r'<link>(https?://[^<]+)</link>', text)
                dates  = re.findall(r'<pubDate>(.*?)</pubDate>', text)
                articles = [{"title": t, "url": l, "published": d}
                            for t, l, d in zip(titles[1:], links[1:], dates[:10])][:10]
                if articles:
                    logger.info(f"[NewsRSS] {len(articles)} articles for: {query}")
                    return {"source": "google_news_rss", "query": query,
                            "articles": articles}
    except Exception as e:
        logger.warning(f"[NewsRSS] {e}")
    return {}



async def fetch_gnews(query: str, session: aiohttp.ClientSession) -> dict:
    """
    GNews.io — 100 free articles/day, no credit card.
    Register free at: gnews.io/register
    Covers 60,000+ sources worldwide.
    """
    if GNEWS_API_KEY:
        url = "https://gnews.io/api/v4/search"
        params = {"q": query, "token": GNEWS_API_KEY, "lang": "en", "max": 10}
        data = await _get(session, url, params=params, label="GNews")
        if data and data.get("articles"):
            arts = data["articles"]
            logger.info(f"[GNews] {len(arts)} articles for: {query}")
            return {
                "source": "gnews", "query": query,
                "articles": [{"title": a.get("title"), "url": a.get("url"),
                              "source": a.get("source", {}).get("name"),
                              "published": a.get("publishedAt"),
                              "description": a.get("description"),
                              "image": a.get("image")} for a in arts],
            }

    # Fallback: CurrentsAPI (600 free/day)
    if CURRENTS_API_KEY:
        url = "https://api.currentsapi.services/v1/search"
        params = {"keywords": query, "apiKey": CURRENTS_API_KEY, "language": "en", "limit": 10}
        data = await _get(session, url, params=params, label="CurrentsAPI")
        if data and data.get("news"):
            news = data["news"]
            logger.info(f"[CurrentsAPI] {len(news)} articles for: {query}")
            return {
                "source": "currents_api", "query": query,
                "articles": [{"title": n.get("title"), "url": n.get("url"),
                              "source": n.get("author"),
                              "published": n.get("published"),
                              "description": n.get("description")} for n in news],
            }

    # Fallback: Google News RSS (always free, no key needed)
    return await fetch_news_rss(query, session)


async def fetch_news_multi(query: str, session: aiohttp.ClientSession) -> dict:
    """
    Try multiple news sources and merge results.
    Priority: GNews → CurrentsAPI → Google News RSS
    """
    result = await fetch_gnews(query, session)
    if result and result.get("articles"):
        return result
    newsapi = await fetch_newsapi(query, session)
    if newsapi and newsapi.get("articles"):
        return newsapi
    # Also try Google News RSS as supplement
    rss = await fetch_news_rss(query, session)
    if rss and rss.get("articles"):
        return rss

    return {}

async def fetch_pastebin_search(query: str, session: aiohttp.ClientSession) -> dict:
    """Pastebin search disabled - psbdmp.ws unreliable."""
    return {}


