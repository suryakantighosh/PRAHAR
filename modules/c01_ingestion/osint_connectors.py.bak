# 30 platforms to check username existence
USERNAME_PLATFORMS = {
    "github":     "https://api.github.com/users/{u}",
    "reddit":     None,
    "twitter":    None,
    "instagram":  None,  # blocks bots
    "tiktok":     None,  # blocks bots
    "youtube":    None,  # returns 200 for any username
    "twitch":     None,  # returns 200 for any username
    "linkedin":   None,  # requires auth
    "medium":     "https://medium.com/@{u}",
    "dev_to":     "https://dev.to/{u}",
    "stackoverflow": "https://stackoverflow.com/users/{u}",
    "hackernews": "https://hacker-news.firebaseio.com/v0/user/{u}.json",
    "gitlab":     "https://gitlab.com/api/v4/users?username={u}",
    "keybase":    "https://keybase.io/{u}/_/api/1.0/user/lookup.json?username={u}",
    "pinterest":  None,
    "telegram":   None,  # returns 200 for any username
    "discord":    None,  # no public API
    "patreon":    "https://www.patreon.com/{u}",
    "producthunt":"https://www.producthunt.com/@{u}",
    "angellist":  "https://angel.co/{u}",
    "behance":    None,  # returns 200 for any username
    "dribbble":   "https://dribbble.com/{u}",
    "npm":        "https://registry.npmjs.org/-/user/org.couchdb.user:{u}",
    "pypi":       None,
    "dockerhub":  None,
    "mastodon":   None,  # returns 200 for any username
    "gravatar":   "https://en.gravatar.com/{u}.json",
    "about_me":   None,  # returns 200 for any username
    "trello":     None,
    "steam":      None,
}


async def check_username_platform(username: str, platform: str, url_tpl: str,
                                   session: aiohttp.ClientSession) -> dict:
    """Check if username exists on a platform. Returns profile data if found."""
    if not url_tpl:
        return {}
    url = url_tpl.format(u=username)
    try:
        async with session.get(url, headers=HEADERS_BROWSER, timeout=TIMEOUT,
                               allow_redirects=True) as r:
            if r.status in (200, 301, 302):
                ct = r.headers.get("Content-Type", "")
                data = {}
                if "json" in ct:
                    try:
                        data = await r.json(content_type=None)
                    except Exception:
                        pass
                return {"platform": platform, "url": str(r.url),
                        "found": True, "data": data}
    except Exception:
        pass
    return {}


async def fetch_username_sweep(username: str, session: aiohttp.ClientSession) -> dict:
    """Check username across all platforms concurrently."""
    tasks = {
        p: check_username_platform(username, p, url, session)
        for p, url in USERNAME_PLATFORMS.items() if url
    }
    results = await asyncio.gather(*tasks.values(), return_exceptions=True)
    found = []
    for platform, result in zip(tasks.keys(), results):
        if isinstance(result, dict) and result.get("found"):
            found.append(result)
            logger.info(f"[UserSweep] {username} found on {platform}")

    if found:
        return {
            "source": "username_sweep", "username": username,
            "platforms_found": len(found),
            "profiles": found,
        }
    return {}


async def fetch_github_user(username: str, session: aiohttp.ClientSession) -> dict:
    """GitHub full profile + repos + gists + orgs."""
    headers = {"Accept": "application/vnd.github+json"}
    if GITHUB_TOKEN:
        headers["Authorization"] = f"Bearer {GITHUB_TOKEN}"
    try:
        async with session.get(f"https://api.github.com/users/{username}",
                               headers=headers, timeout=TIMEOUT) as r:
            if r.status != 200:
                return {}
            profile = await r.json()

        repos, gists, orgs, events = await asyncio.gather(
            _get(session, f"https://api.github.com/users/{username}/repos?per_page=30&sort=updated", headers=headers, label="GH repos"),
            _get(session, f"https://api.github.com/users/{username}/gists?per_page=10", headers=headers, label="GH gists"),
            _get(session, f"https://api.github.com/users/{username}/orgs", headers=headers, label="GH orgs"),
            _get(session, f"https://api.github.com/users/{username}/events/public?per_page=30", headers=headers, label="GH events"),
        )
        logger.info(f"[GitHub] {username} → {len(repos or [])} repos, {len(orgs or [])} orgs")
        return {
            "source": "github", "username": username,
            "profile": profile,
            "repos":   repos or [],
            "gists":   gists or [],
            "orgs":    orgs or [],
            "recent_events": events or [],
        }
    except Exception as e:
        logger.warning(f"[GitHub] {username}: {e}")
    return {}


async def fetch_reddit_user(username: str, session: aiohttp.ClientSession) -> dict:
    """Reddit public profile + recent posts."""
    try:
        h = {"User-Agent": "PRAHAR-OSINT/2.0"}
        about, posts = await asyncio.gather(
            _get(session, f"https://www.reddit.com/user/{username}/about.json", headers=h, label="Reddit"),
            _get(session, f"https://www.reddit.com/user/{username}/submitted.json?limit=25", headers=h, label="Reddit posts"),
        )
        if about and about.get("data"):
            d = about["data"]
            logger.info(f"[Reddit] {username} → {d.get('link_karma',0)} karma")
            return {
                "source": "reddit", "username": username,
                "name":         d.get("name"),
                "created_utc":  d.get("created_utc"),
                "link_karma":   d.get("link_karma"),
                "comment_karma":d.get("comment_karma"),
                "is_gold":      d.get("is_gold"),
                "icon_img":     d.get("icon_img"),
                "posts": [
                    {"title": p["data"].get("title"), "subreddit": p["data"].get("subreddit"),
                     "score": p["data"].get("score"), "url": p["data"].get("url")}
                    for p in (posts or {}).get("data", {}).get("children", [])[:10]
                    if p.get("data")
                ],
            }
    except Exception as e:
        logger.warning(f"[Reddit] {username}: {e}")
    return {}


async def fetch_hackernews_user(username: str, session: aiohttp.ClientSession) -> dict:
    """HackerNews public user data."""
    data = await _get(session, f"https://hacker-news.firebaseio.com/v0/user/{username}.json", label="HN")
    if data and data.get("id"):
        logger.info(f"[HackerNews] Found user: {username}")
        return {
            "source": "hackernews", "username": username,
            "karma": data.get("karma"), "about": data.get("about"),
            "created": data.get("created"),
            "submitted_count": len(data.get("submitted", [])),
        }
    return {}


async def fetch_keybase(username: str, session: aiohttp.ClientSession) -> dict:
    """Keybase identity proofs."""
    data = await _get(session, f"https://keybase.io/_/api/1.0/user/lookup.json?username={username}", label="Keybase")
    if data and data.get("them"):
        them = data["them"][0] if isinstance(data["them"], list) else data["them"]
        proofs = them.get("proofs_summary", {}).get("all", [])
        logger.info(f"[Keybase] {username} → {len(proofs)} proofs")
        return {
            "source": "keybase", "username": username,
            "full_name": them.get("profile", {}).get("full_name"),
            "location":  them.get("profile", {}).get("location"),
            "bio":       them.get("profile", {}).get("bio"),
            "proofs":    [{"proof_type": p.get("proof_type"), "nametag": p.get("nametag"),
                           "state": p.get("state")} for p in proofs],
        }
    return {}


async def fetch_gitlab_user(username: str, session: aiohttp.ClientSession) -> dict:
    """GitLab public user profile."""
    data = await _get(session, f"https://gitlab.com/api/v4/users?username={username}", label="GitLab")
    if data and isinstance(data, list) and data:
        u = data[0]
        logger.info(f"[GitLab] Found: {username}")
        return {
            "source": "gitlab", "username": username,
            "name":       u.get("name"),
            "bio":        u.get("bio"),
            "location":   u.get("location"),
            "website":    u.get("website_url"),
            "avatar":     u.get("avatar_url"),
            "created_at": u.get("created_at"),
        }
    return {}


async def fetch_npm_user(username: str, session: aiohttp.ClientSession) -> dict:
    """npm registry user profile."""
    data = await _get(session, f"https://registry.npmjs.org/-/user/org.couchdb.user:{username}", label="npm")
    if data and data.get("name"):
        return {
            "source": "npm", "username": username,
            "email": data.get("email"), "twitter": data.get("twitter"),
            "github": data.get("github"), "fullname": data.get("fullname"),
        }
    return {}


async def fetch_pypi_user(username: str, session: aiohttp.ClientSession) -> dict:
    """PyPI packages by author."""
    data = await _get(session, f"https://pypi.org/simple/", label="PyPI-check")
    # Search PyPI JSON API for packages by this author
    search_url = f"https://pypi.org/pypi/{username}/json"
    pkg = await _get(session, search_url, label="PyPI")
    if pkg and pkg.get("info"):
        i = pkg["info"]
        return {
            "source": "pypi", "username": username,
            "package": i.get("name"), "author": i.get("author"),
            "email": i.get("author_email"), "summary": i.get("summary"),
            "home_page": i.get("home_page"),
        }
    return {}


