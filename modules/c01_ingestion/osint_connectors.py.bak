async def fetch_crtsh(domain: str, session: aiohttp.ClientSession) -> dict:
    url = f"https://crt.sh/?q=%.{domain}&output=json"
    data = await _get(session, url, label="crt.sh")
    if data and isinstance(data, list):
        subdomains = list({e["name_value"] for e in data})
        logger.info(f"[crt.sh] {domain} → {len(subdomains)} subdomains")
        return {"source": "crt.sh", "domain": domain, "subdomains": subdomains}
    return {}


async def fetch_rdap(domain: str, session: aiohttp.ClientSession) -> dict:
    data = await _get(session, f"https://rdap.org/domain/{domain}", label="RDAP")
    if data:
        logger.info(f"[RDAP] {domain} → registrar fetched")
        return {"source": "rdap", "domain": domain, "rdap": data}
    return {}


async def fetch_wayback(url_target: str, session: aiohttp.ClientSession, limit=30) -> dict:
    cdx = (f"http://web.archive.org/cdx/search/cdx"
           f"?url={url_target}&output=json&limit={limit}&fl=timestamp,original,statuscode")
    data = await _get(session, cdx, label="Wayback")
    if data and isinstance(data, list) and len(data) > 1:
        return {"source": "wayback", "target": url_target, "snapshots": data[1:]}
    return {}


async def fetch_shodan(ip: str, session: aiohttp.ClientSession) -> dict:
    if not SHODAN_API_KEY:
        return {}
    data = await _get(session, f"https://api.shodan.io/shodan/host/{ip}?key={SHODAN_API_KEY}", label="Shodan")
    if data:
        logger.info(f"[Shodan] {ip} → {len(data.get('ports',[]))} ports")
        return {"source": "shodan", "ip": ip, "data": data}
    return {}


async def fetch_virustotal_domain(domain: str, session: aiohttp.ClientSession) -> dict:
    if not VIRUSTOTAL_API_KEY:
        return {}
    data = await _get(session, f"https://www.virustotal.com/api/v3/domains/{domain}",
                      headers={"x-apikey": VIRUSTOTAL_API_KEY}, label="VirusTotal")
    if data:
        return {"source": "virustotal", "domain": domain, "data": data}
    return {}


async def resolve_dns(domain: str) -> dict:
    import asyncio
    loop = asyncio.get_event_loop()
    try:
        infos = await loop.getaddrinfo(domain, None)
        ips = list({i[4][0] for i in infos})
        return {"source": "dns_resolver", "domain": domain, "ips": ips}
    except Exception as e:
        logger.warning(f"[DNS] {domain}: {e}")
    return {}


async def fetch_whois_json(domain: str, session: aiohttp.ClientSession) -> dict:
    """Free WHOIS via whois.jsonwhois.io."""
    data = await _get(session, f"https://jsonwhois.io/api/v1/whois?domain={domain}",
                      headers={"Accept": "application/json"}, label="WHOIS")
    if data:
        return {"source": "whois", "domain": domain, "data": data}
    return {}


async def fetch_dnsdumpster(domain: str, session: aiohttp.ClientSession) -> dict:
    """HackerTarget DNS lookup — free."""
    data = await _get(session, f"https://api.hackertarget.com/dnslookup/?q={domain}", label="DNSDumpster")
    if data and data.get("raw_text"):
        return {"source": "dnsdumpster", "domain": domain, "records": data["raw_text"]}
    return {}


async def fetch_hackertarget_reverseip(ip: str, session: aiohttp.ClientSession) -> dict:
    data = await _get(session, f"https://api.hackertarget.com/reverseiplookup/?q={ip}", label="HackerTarget")
    if data and data.get("raw_text"):
        return {"source": "hackertarget_reverseip", "ip": ip,
                "domains": data["raw_text"].strip().splitlines()}
    return {}


# ══════════════════════════════════════════════════════════════
#  PHONE SOURCES
# ══════════════════════════════════════════════════════════════

async def fetch_numverify(phone: str, session: aiohttp.ClientSession) -> dict:
    """Numverify free phone lookup (limited)."""
    # Free endpoint without key for basic validation
    try:
        import phonenumbers
        parsed = phonenumbers.parse(phone, None)
        from phonenumbers import geocoder, carrier, timezone
        return {
            "source": "phonenumbers_lib",
            "phone": phone,
            "valid": phonenumbers.is_valid_number(parsed),
            "country": geocoder.description_for_number(parsed, "en"),
            "carrier": carrier.name_for_number(parsed, "en"),
            "timezones": list(timezone.time_zones_for_number(parsed)),
            "number_type": str(phonenumbers.number_type(parsed)),
            "e164": phonenumbers.format_number(parsed, phonenumbers.PhoneNumberFormat.E164),
        }
    except Exception as e:
        logger.warning(f"[PhoneNumbers] {phone}: {e}")
    return {}


# ══════════════════════════════════════════════════════════════
#  FACE / IMAGE SOURCES
# ══════════════════════════════════════════════════════════════

async def search_face_tineye(image_url: str, session: aiohttp.ClientSession) -> dict:
    """TinEye reverse image search."""
    try:
        url = f"https://tineye.com/search?url={image_url}"
        async with session.get(url, headers=HEADERS_BROWSER, timeout=TIMEOUT) as r:
            if r.status == 200:
                text = await r.text()
                # Parse result count from page
                import re
                match = re.search(r'(\d+)\s+results?', text, re.IGNORECASE)
                count = int(match.group(1)) if match else 0
                logger.info(f"[TinEye] {count} matches for image")
                return {"source": "tineye", "image_url": image_url,
                        "match_count": count, "search_url": url}
    except Exception as e:
        logger.warning(f"[TinEye] {e}")
    return {}


async def analyze_face_deepface(image_b64: str) -> dict:
    """DeepFace analysis — age, gender, emotion, ethnicity."""
    try:
        import base64, tempfile, os
        from deepface import DeepFace
        img_bytes = base64.b64decode(image_b64)
        with tempfile.NamedTemporaryFile(suffix=".jpg", delete=False) as f:
            f.write(img_bytes)
            tmp = f.name
        result = DeepFace.analyze(tmp, actions=["age", "gender", "emotion", "race"],
                                  enforce_detection=False, silent=True)
        os.unlink(tmp)
        if isinstance(result, list):
            result = result[0]
        logger.info("[DeepFace] Analysis complete")
        return {
            "source": "deepface_analysis",
            "age":        result.get("age"),
            "gender":     result.get("dominant_gender"),
            "emotion":    result.get("dominant_emotion"),
            "ethnicity":  result.get("dominant_race"),
            "gender_probs":   result.get("gender", {}),
            "emotion_probs":  result.get("emotion", {}),
            "race_probs":     result.get("race", {}),
        }
    except Exception as e:
        logger.warning(f"[DeepFace] {e}")
    return {}


async def extract_face_embedding(image_b64: str) -> dict:
    """Extract face embedding vector for similarity search."""
    try:
        import base64, tempfile, os
        from deepface import DeepFace
        img_bytes = base64.b64decode(image_b64)
        with tempfile.NamedTemporaryFile(suffix=".jpg", delete=False) as f:
            f.write(img_bytes)
            tmp = f.name
        embedding = DeepFace.represent(tmp, model_name="ArcFace",
                                       enforce_detection=False)
        os.unlink(tmp)
        if isinstance(embedding, list) and embedding:
            vec = embedding[0].get("embedding", [])
            logger.info(f"[FaceEmbed] Extracted {len(vec)}D ArcFace vector")
            return {"source": "face_embedding", "model": "ArcFace",
                    "dims": len(vec), "embedding": vec[:10]}  # store first 10 dims only
    except Exception as e:
        logger.warning(f"[FaceEmbed] {e}")
    return {}


