"""
prahar/modules/c01_ingestion/osint_connectors.py
Full OSINT connector suite — 25+ sources for person, username, domain, email, phone, face.
All connectors are async and return a dict ready for audit.store_record().
"""
import asyncio
import base64
import os
import re
import json
from datetime import datetime
from loguru import logger
import aiohttp
from typing import Optional, List

# ── API keys from env ─────────────────────────────────────────
GITHUB_TOKEN       = os.getenv("GITHUB_TOKEN", "")
SHODAN_API_KEY     = os.getenv("SHODAN_API_KEY", "")
VIRUSTOTAL_API_KEY = os.getenv("VIRUSTOTAL_API_KEY", "")
ABUSEIPDB_API_KEY  = os.getenv("ABUSEIPDB_API_KEY", "")
GOOGLE_CSE_KEY     = os.getenv("GOOGLE_CSE_KEY", "")
GOOGLE_CSE_ID      = os.getenv("GOOGLE_CSE_ID", "")
HIBP_API_KEY       = os.getenv("HIBP_API_KEY", "")
HUNTER_API_KEY     = os.getenv("HUNTER_IO_API_KEY", "")
GNEWS_API_KEY      = os.getenv("GNEWS_API_KEY", "")       # free: gnews.io/register
CURRENTS_API_KEY   = os.getenv("CURRENTS_API_KEY", "")    # free: currentsapi.services
NEWSAPI_KEY = os.getenv("NEWSAPI_KEY", "")
TIMEOUT = aiohttp.ClientTimeout(total=30, connect=10)

UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0 Safari/537.36"
HEADERS_BROWSER = {"User-Agent": UA, "Accept-Language": "en-US,en;q=0.9"}


async def _get(session, url, headers=None, params=None, label="") -> Optional[dict]:
    try:
        h = {**HEADERS_BROWSER, **(headers or {})}
        async with session.get(url, headers=h, params=params, timeout=TIMEOUT, ssl=False) as r:
            if r.status == 200:
                ct = r.headers.get("Content-Type", "")
                if "json" in ct:
                    return await r.json(content_type=None)
                return {"raw_text": await r.text()}
            logger.debug(f"[{label}] HTTP {r.status}")
    except Exception as e:
        if "Cannot connect" in str(e) or "timeout" in str(e).lower():
            logger.warning(f"[{label}] CONNECTION FAILED: {type(e).__name__}: {str(e)[:100]}")
        else:
            logger.warning(f"[{label}] {e}")
    return None


# ══════════════════════════════════════════════════════════════
#  PERSON / NAME SOURCES
# ══════════════════════════════════════════════════════════════

async def fetch_wikipedia(name: str, session: aiohttp.ClientSession) -> dict:
    """Wikipedia summary for a person by name."""
    clean = name.strip().title()
    url = "https://en.wikipedia.org/api/rest_v1/page/summary/" + name.replace(" ", "_")
    data = await _get(session, url, label="Wikipedia")
    if data and data.get("type") != "https://mediawiki.org/wiki/HyperSwitch/errors/not_found":
        logger.info(f"[Wikipedia] Found article for: {name}")
        return {
            "source": "wikipedia", "name": name,
            "title":   data.get("title"),
            "extract": data.get("extract"),
            "thumbnail": data.get("thumbnail", {}).get("source"),
            "url":     data.get("content_urls", {}).get("desktop", {}).get("page"),
            "description": data.get("description"),
        }
    return {}


async def fetch_wikidata(name: str, session: aiohttp.ClientSession) -> dict:
    """Wikidata structured entity data."""
    url = "https://www.wikidata.org/w/api.php"
    params = {"action": "wbsearchentities", "search": name, "language": "en",
              "format": "json", "type": "item", "limit": 3}
    data = await _get(session, url, params=params, label="Wikidata")
    if data and data.get("search"):
        results = data["search"]
        logger.info(f"[Wikidata] {len(results)} entities for: {name}")
        return {"source": "wikidata", "name": name, "entities": results}
    return {}


async def fetch_duckduckgo(query: str, session: aiohttp.ClientSession) -> dict:
    """DuckDuckGo instant answers API."""
    url = "https://api.duckduckgo.com/"
    params = {"q": query, "format": "json", "no_html": "1", "skip_disambig": "1"}
    data = await _get(session, url, params=params, label="DuckDuckGo")
    if data and (data.get("AbstractText") or data.get("Answer") or data.get("RelatedTopics")):
        logger.info(f"[DuckDuckGo] Got results for: {query}")
        return {
            "source": "duckduckgo", "query": query,
            "abstract": data.get("AbstractText"),
            "answer":   data.get("Answer"),
            "image":    data.get("Image"),
            "source_url": data.get("AbstractURL"),
            "related": [t.get("Text") for t in data.get("RelatedTopics", [])[:5] if isinstance(t, dict)],
        }
    return {}


async def fetch_google_cse(query: str, session: aiohttp.ClientSession) -> dict:
    """Google Custom Search — returns top 10 results."""
    if not GOOGLE_CSE_KEY or not GOOGLE_CSE_ID:
        logger.debug("[Google CSE] No API key configured")
        return {}
    url = "https://www.googleapis.com/customsearch/v1"
    params = {"key": GOOGLE_CSE_KEY, "cx": GOOGLE_CSE_ID, "q": query, "num": 10}
    data = await _get(session, url, params=params, label="Google CSE")
    if data and data.get("items"):
        items = data["items"]
        logger.info(f"[Google CSE] {len(items)} results for: {query}")
        return {
            "source": "google_cse", "query": query,
            "results": [{"title": i.get("title"), "url": i.get("link"),
                         "snippet": i.get("snippet")} for i in items],
        }
    return {}


async def fetch_pipl_free(name: str, session: aiohttp.ClientSession) -> dict:
    """Pipl-style people search via free public sources."""
    results = {}
    # Spokeo public search
    try:
        url = f"https://www.spokeo.com/{name.replace(' ', '-')}"
        async with session.get(url, headers=HEADERS_BROWSER, timeout=TIMEOUT) as r:
            if r.status == 200:
                text = await r.text()
                results["spokeo_found"] = "spokeo.com" in r.url.human_repr()
    except Exception:
        pass
    if results:
        return {"source": "people_search", "name": name, **results}
    return {}


