async def fetch_hibp(email: str, session: aiohttp.ClientSession) -> dict:
    """HIBP disabled — paid API. Use free alternatives."""
    return {}  # disabled - requires paid subscription
    url = f"https://haveibeenpwned.com/api/v3/breachedaccount/{email}"
    headers = {"hibp-api-key": HIBP_API_KEY, "user-agent": "PRAHAR-OSINT"}
    data = await _get(session, url, headers=headers, label="HIBP")
    if data and isinstance(data, list):
        logger.info(f"[HIBP] {email} → {len(data)} breaches")
        return {
            "source": "hibp", "email": email,
            "breach_count": len(data),
            "breaches": [{"name": b.get("Name"), "date": b.get("BreachDate"),
                          "data_classes": b.get("DataClasses", [])} for b in data],
        }
    return {}


async def fetch_breach_free(email: str, session: aiohttp.ClientSession) -> dict:
    """
    Free breach check via C2 free API — no key needed.
    Uses emailrep.io (free tier: 1000/day) for reputation.
    """
    try:
        url = f"https://emailrep.io/{email}"
        headers = {"User-Agent": "PRAHAR-OSINT/2.0"}
        async with session.get(url, headers=headers, timeout=TIMEOUT, ssl=False) as r:
            if r.status == 200:
                data = await r.json(content_type=None)
                if data:
                    logger.info(f"[EmailRep] Got reputation for {email}")
                    return {
                        "source": "emailrep",
                        "email": email,
                        "reputation": data.get("reputation"),
                        "suspicious": data.get("suspicious"),
                        "references": data.get("references"),
                        "details": data.get("details", {}),
                        "breach_count": data.get("details", {}).get("data_breach", False),
                        "profiles": list(data.get("details", {}).get("profiles", [])),
                        "first_seen": data.get("details", {}).get("first_seen"),
                        "last_seen": data.get("details", {}).get("last_seen"),
                    }
    except Exception as e:
        logger.warning(f"[EmailRep] {e}")
    return {}


async def fetch_gravatar(email: str, session: aiohttp.ClientSession) -> dict:
    """Gravatar profile from email hash."""
    import hashlib
    email_hash = hashlib.md5(email.lower().strip().encode()).hexdigest()
    data = await _get(session, f"https://en.gravatar.com/{email_hash}.json", label="Gravatar")
    if data and data.get("entry"):
        e = data["entry"][0]
        logger.info(f"[Gravatar] Profile found for email hash")
        return {
            "source": "gravatar", "email": email,
            "displayName":  e.get("displayName"),
            "preferredUsername": e.get("preferredUsername"),
            "thumbnailUrl": e.get("thumbnailUrl"),
            "aboutMe":      e.get("aboutMe"),
            "profileUrl":   e.get("profileUrl"),
            "accounts":     e.get("accounts", []),
            "urls":         e.get("urls", []),
        }
    return {}


async def fetch_hunter_email(domain: str, name: str, session: aiohttp.ClientSession) -> dict:
    """Hunter.io disabled — use free alternatives."""
    return {}  # disabled - very limited free tier
    parts = name.strip().split()
    params = {"domain": domain, "first_name": parts[0] if parts else name,
              "last_name": parts[-1] if len(parts) > 1 else "",
              "api_key": HUNTER_API_KEY}
    data = await _get(session, "https://api.hunter.io/v2/email-finder", params=params, label="Hunter.io")
    if data and data.get("data", {}).get("email"):
        d = data["data"]
        logger.info(f"[Hunter.io] Found email for {name} @ {domain}")
        return {"source": "hunter_io", "name": name, "domain": domain,
                "email": d.get("email"), "confidence": d.get("score"),
                "sources": d.get("sources", [])}
    return {}


